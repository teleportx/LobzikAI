DEBUG=TRUE
HOST=http://127.0.0.1:8000

DB_URL=postgresql://lobzikai:lobzikai@127.0.0.1:5432/lobzikai
AMQP_URL=amqp://guest:guest@127.0.0.1:5672/
REDIS_URL=redis://lobzikai:lobzikai@127.0.0.1:6379/0

OPENAI_API_KEY=secret
OPENAI_BASE_URL=https://polza.ai/api/v1
LANGSMITH_API_KEY=secret
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=LobzikAI
BOT_TOKEN=secret
JWT_SECRET=secret

TELEGRAM_BOT_API_SERVER=may_be_null

ASR_MODEL=bzikst/faster-whisper-large-v3-russian-int8
ASR_DEVICE=cuda
ASR_BATCH_SIZE=4
ASR_COMPUTE_DTYPE=int8_float16

MODEL_CACHE_DIR=./cache
SUMMARIZATION_MODEL=gpt-5-mini
BASE_GPT_MODEL=gpt-4o-mini

S3_ENDPOINT=secret
S3_BUCKET=secret
S3_SSL=TRUE
S3_ACCESS_KEY=secret
S3_SECRET_KEY=secret
