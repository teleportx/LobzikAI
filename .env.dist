BASE_GPT_MODEL=openai/gpt-4o-mini
MM_MODEL=google/gemini-2.5-flash
LOCAL_ASR_VOSK_MODEL=vosk-model-ru-0.22

TELEGRAM_BOT_API_SERVER=may_be_null

JWT_SECRET=secret # jews secret
